{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "noUnusedLocals": true,  //Перед билдом можно поставить false чтобы не ебать мозги НО ОБЯЗАТЕЛЬНО ВЕРНУТЬ true И ПОЧИНИТЬ КОД
    "noUnusedParameters": true, //Перед билдом можно поставить false чтобы не ебать мозги НО ОБЯЗАТЕЛЬНО ВЕРНУТЬ true И ПОЧИНИТЬ КОД
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}